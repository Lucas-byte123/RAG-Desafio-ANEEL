# RAG ANEEL — variaveis de ambiente
# Copie pra .env (que esta no .gitignore) e preencha os valores
# Uso: source .env (Linux/Mac) ou set-content via PowerShell (Windows)

# ─── Oracle Autonomous Database 23ai ───
# Senha do usuario ADMIN do Autonomous DB (definida ao provisionar o ATP)
DB_ADMIN_PASS=

# ─── OCI Generative AI ───
# Configuracao OCI fica em ~/.oci/config (criada pelo `oci setup config`)
# Aqui so precisa do override de regiao se quiser forcar diferente do config
# Default usado pelo agent: sa-saopaulo-1
# OCI_REGION=sa-saopaulo-1

# ─── OCI Object Storage (so se for rodar downloader/extract) ───
# Namespace tenant-unico. Descobrir com: oci os ns get
# OCI_NAMESPACE=

# ─── Wallet do Autonomous DB (so se quiser sobrescrever .secrets/wallet.pass) ───
# WALLET_PASS=

# ─── Deploy de producao (so usado em /etc/rag-aneel.env, ver DEPLOY.md) ───
# HEALTH_PORT=8502
# HEALTH_HOST=127.0.0.1

# ─── Comportamento do RAG ───
# Ativa HyDE (Hypothetical Document Embedding) pra queries vagas
# Default: desativado (ganho marginal vs custo de latencia ~3s)
# HYDE_ENABLED=1

# ─── Cache HuggingFace (bge-reranker) ───
# Onde baixar/cachear o modelo bge-reranker-v2-m3 (~600 MB)
# Default: ~/.cache/huggingface
# HF_HOME=/path/to/cache
